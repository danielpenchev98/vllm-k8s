    {
      "type": "timeseries",
      "title": "VRAM per pod",
      "description": "vLLM preallocates --gpu-memory-utilization of VRAM up front; see the vLLM dashboard for actual KV-cache use",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, pod) (DCGM_FI_DEV_FB_USED{namespace=~\"$namespace\", pod=~\"$pod\"}) * 1024 * 1024",
          "legendFormat": "{{pod}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, pod) (DCGM_FI_DEV_FB_USED{namespace=~\"$namespace\", pod=~\"$pod\"} + DCGM_FI_DEV_FB_FREE{namespace=~\"$namespace\", pod=~\"$pod\"} + DCGM_FI_DEV_FB_RESERVED{namespace=~\"$namespace\", pod=~\"$pod\"}) * 1024 * 1024",
          "legendFormat": "{{pod}} total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* total$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
